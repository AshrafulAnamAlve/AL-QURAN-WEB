{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",

  "//": "Origins allowed to call this API from a browser. Add your deployed frontend URL here before deploying.",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },

  "//Cache": "How long responses from the free upstream APIs are kept in memory (minutes).",
  "Cache": {
    "QuranMinutes": 10080,
    "PrayerMinutes": 720,
    "GeocodingMinutes": 1440,
    "MosqueMinutes": 1440,
    "SizeLimit": 5000
  },

  "//ExternalApis": "Every API below is FREE and needs NO API key. ApiKey is left empty on purpose - see API_SETUP.md.",
  "ExternalApis": {
    "QuranApi": {
      "DisplayName": "AlQuran.cloud",
      "BaseUrl": "https://api.alquran.cloud/v1/",
      "ApiKey": "",
      "TimeoutSeconds": 20,
      "Enabled": true,
      "DocsUrl": "https://alquran.cloud/api",
      "ArabicEdition": "quran-uthmani",
      "BanglaEdition": "bn.bengali",
      "EnglishEdition": "en.sahih"
    },
    "QuranAudio": {
      "DisplayName": "islamic.network Quran audio CDN",
      "BaseUrl": "https://cdn.islamic.network/quran/audio/",
      "ApiKey": "",
      "TimeoutSeconds": 20,
      "Enabled": true,
      "DocsUrl": "https://islamic.network/quran/audio",
      "//ReciterNote": "The reciters that can be played one ayah at a time, and the bitrate each is stored under, are the verified table in Services/Quran/Reciters.cs. Bitrate below is only the fallback for an identifier not in that table.",
      "DefaultReciter": "ar.alafasy",
      "Bitrate": 128
    },
    "PrayerApi": {
      "DisplayName": "Aladhan",
      "BaseUrl": "https://api.aladhan.com/v1/",
      "ApiKey": "",
      "TimeoutSeconds": 20,
      "Enabled": true,
      "DocsUrl": "https://aladhan.com/prayer-times-api",
      "DefaultMethod": 1,
      "DefaultSchool": 1
    },
    "GeocodingApi": {
      "DisplayName": "OpenStreetMap Nominatim",
      "BaseUrl": "https://nominatim.openstreetmap.org/",
      "ApiKey": "",
      "TimeoutSeconds": 20,
      "Enabled": true,
      "DocsUrl": "https://nominatim.org/release-docs/latest/api/Overview/",
      "//UserAgentNote": "Nominatim REJECTS placeholder contacts - a User-Agent containing example.com is answered with 403. Replace your-username below with your real GitHub username or contact URL.",
      "UserAgent": "AlQuranWeb/1.0 (+https://github.com/your-username/al-quran-web)",
      "MaxResults": 8
    },
    "OverpassApi": {
      "DisplayName": "Overpass API (OpenStreetMap)",
      "BaseUrl": "https://overpass-api.de/api/interpreter",
      "IsSingleEndpoint": true,
      "ApiKey": "",
      "TimeoutSeconds": 45,
      "Enabled": true,
      "DocsUrl": "https://wiki.openstreetmap.org/wiki/Overpass_API",
      "MirrorUrls": [
        "https://overpass.private.coffee/api/interpreter",
        "https://overpass.kumi.systems/api/interpreter"
      ],
      "DefaultRadiusMeters": 3000,
      "MaxResults": 60
    }
  }
}
