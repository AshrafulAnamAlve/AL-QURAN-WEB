<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AlQuran.Api</RootNamespace>
    <!-- Arabic / Bangla text handling needs full ICU globalization data. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 1591 = "missing XML comment"; we document the public API surface, not every member. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Built-in OpenAPI document generation (no Swashbuckle needed on .NET 10).
         Kept at 10.0.11 deliberately: the 10.0.7 the template ships with drags in
         Microsoft.OpenApi 2.0.0, which carries advisory GHSA-v5pm-xwqc-g5wc. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!-- Retry + circuit breaker + timeout for the free upstream APIs we depend on. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <!-- Browsable API explorer at /scalar (development only). -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.2" />
  </ItemGroup>

</Project>
