{
  "manifest_version": 3,
  "name": "Al-Quran & Halal Web Shield (আল-কুরআন ও হালাল শিল্ড)",
  "short_name": "Al-Quran Shield",
  "version": "1.0.0",
  "description": "Complete Islamic companion with prayer times, daily Quran & Hadith, Noor AI, plus Reels blocker, adult blocker, and ad guard.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    },
    "default_title": "Al-Quran & Halal Web Shield"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "alarms",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.facebook.com/*",
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*",
    "*://*.google.com/*",
    "*://*.bing.com/*",
    "*://*.duckduckgo.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "adult_rules",
        "enabled": true,
        "path": "rules/adult-rules.json"
      },
      {
        "id": "ad_rules",
        "enabled": true,
        "path": "rules/ad-rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*"
      ],
      "js": ["content-scripts/reels-blocker.js"],
      "css": ["content-scripts/reels-blocker.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked/blocked.html",
        "assets/icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
