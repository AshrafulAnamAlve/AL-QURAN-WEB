{
  "appId": "com.alquran.desktop",
  "productName": "Al-Quran",
  "copyright": "Copyright © 2026 Al-Quran",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "assets/**/*",
    {
      "from": "../frontend/dist/frontend/browser",
      "to": "dist/frontend/browser",
      "filter": ["**/*"]
    }
  ],
  "extraMetadata": {
    "main": "dist/main/index.js"
  },
  "win": {
    "icon": "assets/icons/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Al-Quran"
  },
  "mac": {
    "category": "public.app-category.education",
    "target": ["dmg", "zip"]
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Education"
  }
}
